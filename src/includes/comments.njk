{% macro commentsList(comments, canReply) %}
    <ul>
        {% for comment in comments %}
            <li data-comment-id="{{ comment._id }}">
                <p class="comment-details" >
                    {% if comment.url %}
                        <a class="comment-author" href="{{ comment.url }}">{{ comment.name }}</a>
                    {% else %}
                        <span class="comment-author">{{ comment.name }}</span>
                    {% endif %}
          ({{ comment.date | dateAndTime }}): 
        </p>
                <p class="comment-message{% if not canReply and not comment.reactions %} no-reply{% endif %}">{{ comment.message }}</p>
                {% if canReply or comment.reactions %}
                <div class="comment-actions">
                    {% if canReply %}
                    <button class="comment-reply">
          להגיב
        </button>
                    {% endif %}
                    {% if comment.reactions %}
                    <div class="comment-reactions">
                        {% for reaction in comment.reactions %}
                        {% set authors = reaction.names | join(", ") %}
                        <button type="button" class="comment-reaction" aria-expanded="false" aria-label="{{ reaction.emoji }} {{ authors }}">
                            {{ reaction.emoji }}{% if reaction.names.length > 1 %}<span class="comment-reaction-count">{{ reaction.names.length }}</span>{% endif %}
                            <span class="comment-reaction-authors">{{ authors }}</span>
                        </button>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
                {% endif %}
                {% if comment.replies %}
                    {{ commentsList(comment.replies, canReply) }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% set canComment = allowNewComments and not disableNewComments %}

<div class="comments" id="comments">
    {%if (postComments.length) %}
        <h3>תגובות:</h3>
        {{ commentsList(postComments, canComment) }}
    {% endif %}

    {% if canComment %}
        <div id="respond" class="comment-new">
            {% include 'comment-form.njk' %}
        </div>
        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    {% endif %}
</div>