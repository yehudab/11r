{%- set isPost = type == "post" %}
{%- if date or isPost or numComments.count > 0 %}
<div class="post-meta">
    {%- if date %}
    <span>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        נכתב ב<time datetime="{{ date | dateISO }}">{{ date | dateDisplay }}</time>
        {%- if lastUpdate %},
            עדכון אחרון: <time datetime="{{ lastUpdate | dateISO }}">{{ lastUpdate | dateDisplay }}</time>
        {%- endif %}
    </span>
    {%- endif %}

    {%- if isPost %}
    <span>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        {{ content | readingTime }}
    </span>
    {%- endif %}

    {%- if numComments.count > 0 %}
    <a class="comments-count" href="#comments">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9 9 0 0 1-4-.9L3 21l1.9-5A8.4 8.4 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5z"/></svg>
        {{ numComments.text }}
    </a>
    {%- endif %}

    {%- if tags %}
    <span class="tags">
        {%- for tag in tags %}
            {%- if tag !== "post" %}
            <a class="tag" href="{{ site.baseUrl }}tag/{{ tag }}/">{{ tag }}</a>
            {%- endif %}
        {%- endfor %}
    </span>
    {%- endif %}
</div>
{%- endif %}
