---
pagination:
    data: maps
    size: 1
    alias: map
permalink: "maps/trail-{{ map.number }}/"
hasOwnTitle: true
eleventyComputed:
  title: "מפת מקטע מס׳ {{map.number}}"
---
{% extends 'page.njk' %}
{% block body %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.3/dist/leaflet.css"
     integrity="sha256-kLaT2GOSpHechhsozzB+flnD+zUyjE2LlfWPgU04xyI="
     crossorigin=""/>
  <script src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js"
     integrity="sha256-WBkoXOwTeyKclOHuWtc+i2uENFpDZ9YPdf5Hf+D7ewM="
     crossorigin=""></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"
     integrity="sha256-YU3qCpj/P06tdPBJGPax0bm6Q1wltfwjsho5TR4+TYc="
     crossorigin=""/>
  <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"
     integrity="sha256-Hk4dIpcqOSb0hZjgyvFOP+cEmDXUKKNE/tT542ZbNQg="
     crossorigin=""></script>
  <h1 class="text-center">מפת קטע מס׳ {{map.name}}</h1>
  <p class="text-center text-sm italic mb-6">לא מתאימה לצרכי לניווט</p>
  <div id="map"></div>
  <style>
    html,body { height: 100%; }
    main { min-height: 100%; }
    #map { height: calc(100% - 7rem); }
    /* Leaflet sets width: auto on marker images, with this specificity */
    .leaflet-container .leaflet-marker-pane .photo-thumb img {
      width: 56px;
      height: 56px;
      margin: 0;
      object-fit: cover;
      border: 2px solid #fff;
      border-radius: 6px;
      box-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
    }
    .photo-thumb span {
      position: absolute;
      top: -8px;
      right: -8px;
      min-width: 22px;
      line-height: 22px;
      text-align: center;
      font-size: 12px;
      color: #fff;
      background: #ff7800;
      border-radius: 11px;
    }
    .photo-popup { direction: rtl; }
    .photo-popup img { width: 100%; margin: 0 0 0.5rem; }
    .photo-popup p { margin: 0 0 0.25rem; font-weight: bold; }
{% if map.editor %}
    .leaflet-container .leaflet-marker-pane .photo-keep img { border-color: #22c55e; }
    .leaflet-container .leaflet-marker-pane .photo-trash img { border-color: #ef4444; opacity: 0.4; filter: grayscale(1); }
    .leaflet-container .leaflet-marker-pane .photo-candidate img { border: 2px dashed #f59e0b; }
    .photo-editor { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem; }
    .photo-editor button { padding: 0.1rem 0.6rem; font-size: 1.25rem; border: 2px solid #d1d5db; border-radius: 6px; background: #fff; cursor: pointer; }
    .photo-editor button.active { border-color: #2563eb; background: #dbeafe; }
    .photo-editor small { color: #dc2626; }
{% endif %}
  </style>
  
  <script>
    let taril = {{ map.geojsonFeature | safe }};
    let baseStyle = {
        "color": "#ff7800",
        "weight": 5,
        "opacity": 0.65
    };
    let secondStyle = {
        "color": "#000000",
        "weight": 1,
        "opacity": 0.65
    };
    let map = L.map('map').setView([33.22966,35.61782], 13);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);
    let feature = L.geoJSON(taril, { style: baseStyle}).addTo(map);
    L.geoJSON(taril, { style: secondStyle}).addTo(map);
    let bounds = feature.getBounds();

    let photos = {{ map.photos | safe }};
    function thumbIcon(photo, count) {
        let html = document.createElement('div');
        let img = document.createElement('img');
        img.src = photo.thumb;
        img.alt = '';
        html.append(img);
        if (count) {
            let badge = document.createElement('span');
            badge.textContent = count;
            html.append(badge);
        }
        return L.divIcon({ className: 'photo-thumb' + thumbClass(photo), html, iconSize: [56, 56] });
    }
    function photoPopup(photo, marker) {
        let popup = document.createElement('div');
        popup.className = 'photo-popup';
        let img = document.createElement('img');
        img.src = photo.src;
        img.alt = photo.caption;
        img.addEventListener('load', () => marker.getPopup().update());
        let caption = document.createElement('p');
        caption.textContent = photo.caption;
        caption.dir = 'auto';
        popup.append(img, caption);
        addEditorButtons(popup, photo, marker);
        if (photo.postUrl) {
            let link = document.createElement('a');
            link.href = photo.postUrl;
            link.textContent = photo.postTitle;
            popup.append(link);
        }
        return popup;
    }
{% if map.editor %}
    // Dev server only: decide which photos stay on the blog
    let decisions = {};
    let cluster;
    function thumbClass(photo) {
        let status = decisions[photo.id];
        return (status ? ' photo-' + status : '') + (photo.candidate && !status ? ' photo-candidate' : '');
    }
    async function decide(photo, marker, status, message) {
        let next = decisions[photo.id] === status ? null : status;
        let response = await fetch('/api/photo-decisions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: photo.id, status: next })
        }).catch(() => null);
        if (!response?.ok) {
            message.textContent = 'השמירה נכשלה';
            return;
        }
        message.textContent = '';
        if (next) decisions[photo.id] = next;
        else delete decisions[photo.id];
        refreshMarker(photo, marker);
    }
    // A group shows the photo closest to staying on the blog. Published with no decision counts as kept.
    function groupRank(photo) {
        let status = decisions[photo.id];
        if (status === 'trash') return 2;
        return status === 'keep' || !photo.candidate ? 0 : 1;
    }
    function groupPhoto(markers) {
        let [first, ...rest] = markers.map(marker => marker.options.photo);
        return rest.reduce((best, photo) => groupRank(photo) < groupRank(best) ? photo : best, first);
    }
    function refreshMarker(photo, marker) {
        marker.setIcon(thumbIcon(photo));
        cluster.refreshClusters(marker);
        let buttons = marker.getPopup()?.getContent().querySelector('.photo-editor');
        buttons?.querySelectorAll('button').forEach(button => {
            button.classList.toggle('active', decisions[photo.id] === button.dataset.status);
        });
    }
    function addEditorButtons(popup, photo, marker) {
        let buttons = document.createElement('div');
        buttons.className = 'photo-editor';
        let message = document.createElement('small');
        [['keep', '✅', 'להשאיר'], ['trash', '🗑️', 'למחוק']].forEach(([status, icon, label]) => {
            let button = document.createElement('button');
            button.type = 'button';
            button.dataset.status = status;
            button.textContent = icon;
            button.title = label;
            button.setAttribute('aria-label', label);
            button.classList.toggle('active', decisions[photo.id] === status);
            button.addEventListener('click', () => decide(photo, marker, status, message));
            buttons.append(button);
        });
        buttons.append(message);
        popup.append(buttons);
    }
    async function loadDecisions() {
        let response = await fetch('/api/photo-decisions');
        decisions = await response.json();
    }
{% else %}
    function thumbClass() { return ''; }
    function groupPhoto(markers) { return markers[0].options.photo; }
    function addEditorButtons() {}
{% endif %}
    function showPhotos() {
        {% if not map.editor %}let {% endif %}cluster = L.markerClusterGroup({
            maxClusterRadius: 50,
            spiderfyDistanceMultiplier: 2.5,
            showCoverageOnHover: false,
            iconCreateFunction: (group) => thumbIcon(groupPhoto(group.getAllChildMarkers()), group.getChildCount())
        });
        photos.forEach(photo => {
            let marker = L.marker([photo.lat, photo.lon], {
                icon: thumbIcon(photo),
                photo,
                title: photo.caption,
                alt: photo.caption
            });
            marker.bindPopup(photoPopup(photo, marker), { minWidth: 280, maxWidth: 280 });
            cluster.addLayer(marker);
            bounds.extend(marker.getLatLng());
        });
        map.addLayer(cluster);
        map.fitBounds(bounds, { padding: [30, 30] });
    }
    if (photos.length) {
{% if map.editor %}
        loadDecisions().then(showPhotos);
{% else %}
        showPhotos();
{% endif %}
    }
    map.fitBounds(bounds, { padding: [30, 30] });
  </script>
{% endblock %}
